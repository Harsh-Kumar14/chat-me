# ---------------------------------------------------------------------------
# Copy to .env for local dev, and set these same vars in your host (Render).
# Never commit the real .env — it's gitignored.
# ---------------------------------------------------------------------------

# Server
PORT=8000
FRONTEND_URL=https://your-frontend.vercel.app   # your deployed frontend origin (for CORS)

# Databases (all free tiers)
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/dbname   # MongoDB Atlas
REDIS_URL=rediss://default:password@your-endpoint.upstash.io:6379   # Upstash Redis (note: rediss:// = TLS)

# Vector DB — Qdrant Cloud (used by the PDF/RAG agent)
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# LLM / tool providers
GROQ_API_KEY=
GOOGLE_API_KEY=              # used by Gemini chat + embeddings
OPENROUTER_API_KEY=
TAVILY_API_KEY=

# AWS S3 (only if you store generated images/files)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_KEY=

# Firebase Admin:
# The auth service reads services/auth/serviceAccountKey.json.
# On Render, upload that file as a "Secret File" (see DEPLOY.md) instead of committing it.
